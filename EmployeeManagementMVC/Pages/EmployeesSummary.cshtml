@page
@model EmployeeManagementMVC.Pages.EmployeesSummaryModel

@{
    ViewData["Title"] = "Employees Dashboard";
}

<h1 class="mb-4">Employees Dashboard</h1>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm p-3">
            <h5>Total Employees</h5>
            <h2 class="text-primary">@Model.TotalEmployees</h2>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm p-3">
            <h5>Total Departments</h5>
            <h2 class="text-success">@Model.TotalDepartments</h2>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card shadow-sm p-3">
            <h5>Average Salary</h5>
            <h2 class="text-warning">
                @Model.AverageSalary.ToString("N2")
            </h2>
        </div>
    </div>

</div>

