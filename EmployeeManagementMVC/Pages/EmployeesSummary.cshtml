@page
@model EmployeeManagementMVC.Pages.EmployeesSummaryModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Employees Summary Dashboard";
}

<style>
    .dashboard-wrapper {
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 15px;
        background: linear-gradient(135deg, #f4f7fc, #e9eff8);
        border-radius: 18px;
    }

    .dashboard-content {
        width: 100%;
        max-width: 1050px;
        text-align: center;
    }

    .dashboard-title {
        color: #172b4d;
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .dashboard-subtitle {
        color: #718096;
        margin-bottom: 40px;
    }

    .dashboard-card {
        border: none;
        border-radius: 18px;
        padding: 30px 20px;
        height: 100%;
        background: white;
        box-shadow: 0 8px 24px rgba(31, 45, 61, 0.07);
        transition: transform .25s, box-shadow .25s;
        position: relative;
        overflow: hidden;
    }

        .dashboard-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 14px 30px rgba(31, 45, 61, 0.13);
        }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
        }

    .employees-card::before {
        background: #4285f4;
    }

    .departments-card::before {
        background: #20b486;
    }

    .salary-card::before {
        background: #f5a623;
    }

    .card-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin: 0 auto 20px;
    }

    .employees-card .card-icon {
        background: #e8f1ff;
        color: #4285f4;
    }

    .departments-card .card-icon {
        background: #e3f8f0;
        color: #20b486;
    }

    .salary-card .card-icon {
        background: #fff3dc;
        color: #e9a126;
    }

    .dashboard-card h5 {
        color: #64748b;
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .dashboard-card h2 {
        font-size: 2.3rem;
        font-weight: 800;
        margin: 0;
    }

    .employees-card h2 {
        color: #4285f4;
    }

    .departments-card h2 {
        color: #20a77b;
    }

    .salary-card h2 {
        color: #e9a126;
    }

    @@media (max-width: 768px) {
        .dashboard-wrapper {
            min-height: auto;
            padding: 40px 12px;
        }

        .dashboard-title {
            font-size: 1.9rem;
        }
    }
</style>

<div class="dashboard-wrapper">
    <div class="dashboard-content">

        <h1 class="dashboard-title">Employees Summary Dashboard</h1>

        <p class="dashboard-subtitle">
            Monitor your workforce and get an overview of your organization
        </p>

        <div class="row g-4 justify-content-center">

            <div class="col-md-4">
                <div class="dashboard-card employees-card">
                    <div class="card-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5>Total Employees</h5>
                    <h2>@Model.TotalEmployees</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card departments-card">
                    <div class="card-icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <h5>Total Departments</h5>
                    <h2>@Model.TotalDepartments</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-card salary-card">
                    <div class="card-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h5>Average Salary</h5>
                    <h2>@Model.AverageSalary.ToString("N2")</h2>
                </div>
            </div>

        </div>
    </div>
</div>
