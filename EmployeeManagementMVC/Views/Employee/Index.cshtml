@model List<EmployeeManagementMVC.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h1 class="mb-4">Employee Management</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search by name or department..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

<p>
    <strong>Employees on this page:</strong> @Model.Count
</p>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-success mb-3">
        Add New Employee
    </a>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Salary</th>
            <th>Department</th>
            <th>Hire Date</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Actions</th>
            }
        </tr>
    </thead>

    <tbody>
        @if (Model.Any())
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                    <td>@employee.Salary.ToString("N2")</td>
                    <td>@employee.Department</td>
                    <td>@employee.HireDate.ToShortDateString()</td>

                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@employee.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@employee.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No employees found.
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}
